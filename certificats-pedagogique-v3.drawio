        <mxCell id="e1" value="⏰ EXPIRÉ&#xa;&#xa;Comme ta carte périmée :&#xa;le navigateur bloque l&#39;accès.&#xa;→ Panne en prod à 3h du matin 😱" style="rounded=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;align=left;fontSize=12;fontColor=#c0392b;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="855" y="1930" width="235" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="🔓 CLÉ PRIVÉE VOLÉE&#xa;&#xa;Usurpation d&#39;identité totale.&#xa;Le hacker lit tout le trafic.&#xa;→ Révocation immédiate !" style="rounded=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;align=left;fontSize=12;fontColor=#c0392b;arcSize=10;" parent="1" vertex="1">
