        <mxCell id="sD_t" value="ECDHE Key Exchange : nous échangeons des paramètres pour fabriquer&#xa;ensemble une clé de session temporaire — jamais transmise, connue uniquement de nous deux" style="text;html=1;fillColor=none;strokeColor=none;align=left;fontSize=13;fontColor=#1a1a2e;" parent="1" vertex="1">
