        <mxCell id="trust_intro" value="❓ Question clé : Le navigateur vérifie le cert de mabanque.fr, mais comment sait-il que Let&#39;s Encrypt est fiable ?" style="text;html=1;fillColor=none;strokeColor=none;align=left;fontSize=13;fontStyle=2;fontColor=#6b4226;" parent="1" vertex="1">
