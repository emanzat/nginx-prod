        <mxCell id="role1" value="✅ 1. AUTHENTIFIER le serveur&#xa;      Prouver que tu parles bien à mabanque.fr&#xa;      et non à un imposteur (man-in-the-middle)." style="rounded=1;fillColor=#e8f5e9;strokeColor=#2d6a4f;align=left;fontSize=12;fontColor=#1a3d2b;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="675" y="635" width="530" height="65" as="geometry" />
        </mxCell>
        <mxCell id="role2" value="✅ 2. ÉTABLIR un canal sécurisé (TLS)&#xa;      Permettre la négociation d&#39;une clé de session.&#xa;      C&#39;est cette clé de session qui chiffre les données." style="rounded=1;fillColor=#e8f5e9;strokeColor=#2d6a4f;align=left;fontSize=12;fontColor=#1a3d2b;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="675" y="708" width="530" height="65" as="geometry" />
        </mxCell>
        <mxCell id="role_warn" value="⚠️ Idée reçue à corriger :&#xa;     Certificat ≠ chiffrement des données&#xa;     Certificat = identité + confiance → permet le chiffrement" style="rounded=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;align=left;fontSize=12;fontColor=#c0392b;arcSize=10;fontStyle=1;" parent="1" vertex="1">
