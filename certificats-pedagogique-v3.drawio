        </mxCell>
        <mxCell id="e3" value="🚫 CA NON RECONNUE&#xa;&#xa;CA interne absente du Trust Store.&#xa;Le navigateur affiche ⛔ DANGER.&#xa;→ Ajouter la CA dans le store." style="rounded=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;align=left;fontSize=12;fontColor=#c0392b;arcSize=10;" parent="1" vertex="1">
          <mxGeometry x="1355" y="1930" width="235" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="🚨 RÉVOQUÉ (nouveau !)&#xa;&#xa;Le cert est encore valide MAIS&#xa;la CA l&#39;a annulé (clé compromise,&#xa;fraude détectée…)&#xa;→ CRL / OCSP détectent ça !" style="rounded=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=3;align=left;fontSize=12;fontColor=#c0392b;arcSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1605" y="1930" width="285" height="145" as="geometry" />
        </mxCell>
        <mxCell id="rev_detail" value="🔎 CRL (Certificate Revocation List) = Liste noire publiée périodiquement par la CA&#xa;🔎 OCSP (Online Certificate Status Protocol) = Vérification en temps réel auprès de la CA&#xa;🍺 Analogie : Appeler la préfecture pour savoir si la carte est signalée volée avant de laisser entrer." style="rounded=1;fillColor=#1a1a2e;strokeColor=#c0392b;strokeWidth=2;align=left;fontSize=11;fontColor=#ff8a80;arcSize=8;" parent="1" vertex="1">
