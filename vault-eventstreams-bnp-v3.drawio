          <mxGeometry y="42" width="1800" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legendFlowText" value="— Flux Producer (vert)     — Flux Consumer (bleu)     ••• Appels IAM successifs (orange)     ••• Rotation (gris)" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="1150" y="70" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="vaultBox" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00915A;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="40" y="115" width="370" height="565" as="geometry" />
        </mxCell>
        <mxCell id="vaultHeader" value="HashiCorp Vault" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#00543C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="115" width="370" height="42" as="geometry" />
        </mxCell>
        <mxCell id="k8sAuth" value="Auth Method: kubernetes&lt;br&gt;&lt;br&gt;role=producer-app → bound_sa: producer-sa&lt;br&gt;role=consumer-app → bound_sa: consumer-sa&lt;br&gt;TokenReview API (validation SA JWT)&lt;br&gt;&lt;i&gt;policies = [producer-policy] / [consumer-policy]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7F4;strokeColor=#9AA0A6;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="65" y="170" width="315" height="100" as="geometry" />
        </mxCell>
        <mxCell id="policies" value="Policy: producer-policy.hcl (READ-ONLY)&lt;br&gt;path &quot;ibmcloud/creds/producer-role&quot; {&lt;br&gt;  capabilities = [&quot;read&quot;]&lt;br&gt;}&lt;br&gt;&lt;br&gt;Policy: consumer-policy.hcl (READ-ONLY)&lt;br&gt;path &quot;ibmcloud/creds/consumer-role&quot; {&lt;br&gt;  capabilities = [&quot;read&quot;]&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;i&gt;Isolation stricte: aucune policy ne peut lire le role de l&#39;autre&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7F4;strokeColor=#9AA0A6;fontSize=10.6;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="65" y="280" width="315" height="185" as="geometry" />
        </mxCell>
        <mxCell id="secretsEngine" value="Secrets Engine: ibmcloud/ (plugin)&lt;br&gt;Config root: admin API key avec droits IAM&lt;br&gt;&lt;br&gt;&lt;b&gt;IMPORTANT: le plugin orchestre 3 appels&lt;/b&gt;&lt;br&gt;&lt;b&gt;a des API IBM Cloud DISTINCTES&lt;/b&gt; (voir bloc IAM →)&lt;br&gt;&lt;br&gt;&lt;b&gt;Role: producer-role&lt;/b&gt; → Writer scope Event Streams&lt;br&gt;&lt;b&gt;Role: consumer-role&lt;/b&gt; → Reader scope Event Streams&lt;br&gt;&lt;br&gt;ttl=1h / max_ttl=4h (lease)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7F4;strokeColor=#9AA0A6;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="65" y="480" width="315" height="180" as="geometry" />
        </mxCell>
        <mxCell id="iamBox" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#58595B;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="673" y="115" width="380" height="565" as="geometry" />
        </mxCell>
        <mxCell id="iamHeader" value="IBM Cloud IAM - 3 API distinctes" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#58595B;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="673" y="115" width="380" height="42" as="geometry" />
        </mxCell>
        <mxCell id="idApiBox" value="1️⃣ IAM Identity API&lt;br&gt;POST /v1/serviceids&lt;br&gt;&lt;br&gt;Cree une ressource Service ID (identite):&lt;br&gt;svc-vault-producer-&amp;lt;uuid&amp;gt;&lt;br&gt;svc-vault-consumer-&amp;lt;uuid&amp;gt;&lt;br&gt;&lt;i&gt;Ne cree PAS encore de credential utilisable&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3EF;strokeColor=#00915A;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="698" y="170" width="265" height="120" as="geometry" />
        </mxCell>
        <mxCell id="policyApiBox" value="2️⃣ IAM Policy API&lt;br&gt;POST /v1/policies&lt;br&gt;&lt;br&gt;Cree une IAM Authorization Policy qui lie&lt;br&gt;le SID a un role, scopee sur l&#39;instance ES:&lt;br&gt;Producer SID → role &lt;b&gt;Writer&lt;/b&gt;&lt;br&gt;Consumer SID → role &lt;b&gt;Reader&lt;/b&gt;&lt;br&gt;&lt;i&gt;Remplace les ACL Kafka classiques - Event&lt;br&gt;Streams manage n&#39;a pas d&#39;ACL natives, tout&lt;br&gt;passe par IAM&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3EF;strokeColor=#00915A;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="698" y="305" width="275" height="170" as="geometry" />
        </mxCell>
        <mxCell id="apikeyApiBox" value="3️⃣ IAM API Keys API&lt;br&gt;POST /v1/apikeys&lt;br&gt;&lt;br&gt;Cree une API Key attachee au SID&lt;br&gt;(reference son iam_id)&lt;br&gt;&lt;br&gt;&lt;b&gt;C&#39;est CETTE cle - et uniquement elle -&lt;/b&gt;&lt;br&gt;&lt;b&gt;qui est retournee au pod et utilisee pour&lt;/b&gt;&lt;br&gt;&lt;b&gt;l&#39;auth SASL. Le SID lui-meme reste cote IAM.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3EF;strokeColor=#B01B1B;strokeWidth=1.5;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#B01B1B;" parent="1" vertex="1">
          <mxGeometry x="698" y="490" width="275" height="140" as="geometry" />
        </mxCell>
        <mxCell id="esBox" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00915A;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="1090" y="115" width="620" height="340" as="geometry" />
        </mxCell>
        <mxCell id="esHeader" value="IBM Event Streams (Kafka manage)" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#00915A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1090" y="115" width="620" height="42" as="geometry" />
        </mxCell>
        <mxCell id="esAuth" value="Auth SASL_SSL / PLAIN (le SEUL secret transmis au client Kafka)&lt;br&gt;username = &quot;token&quot;&lt;br&gt;password = &amp;lt;API Key dynamique&amp;gt;  ← PAS le SID&lt;br&gt;&lt;i&gt;bootstrap.servers = broker-*.kafka.svc...:9093&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F7F4;strokeColor=#9AA0A6;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="1115" y="175" width="570" height="90" as="geometry" />
        </mxCell>
        <mxCell id="topicBox" value="Topic&lt;br&gt;&lt;br&gt;orders.events&lt;br&gt;partitions: 6 / replication: 3&lt;br&gt;&lt;br&gt;&lt;b&gt;Pas d&#39;ACL Kafka native.&lt;/b&gt;&lt;br&gt;Acces controle en amont par&lt;br&gt;l&#39;IAM Authorization Policy&lt;br&gt;(cf. bloc IAM, etape 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3EF;strokeColor=#00915A;fontSize=11.3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="1115" y="275" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cgBox" value="Consumer Group&lt;br&gt;&lt;br&gt;cg-orders-processor&lt;br&gt;&lt;br&gt;acces restreint via la&lt;br&gt;policy IAM du consumer SID&lt;br&gt;(role Reader)&lt;br&gt;offset commit auto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0F7;strokeColor=#2E5FA3;fontSize=11.3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="1405" y="275" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="producerBox" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#00915A;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="40" y="820" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="producerHeader" value="Pod Producer (OpenShift/K8s)" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#00543C;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="820" width="460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="producerText" value="SA: producer-sa&lt;br&gt;&lt;b&gt;initContainer vault-init&lt;/b&gt;&amp;nbsp;:&lt;br&gt;&amp;nbsp;&amp;nbsp;1) login K8s aupres de Vault&lt;br&gt;&amp;nbsp;&amp;nbsp;2) vault read ibmcloud/creds/producer-role&lt;br&gt;&amp;nbsp;&amp;nbsp;3) ecrit API Key dans emptyDir (tmpfs) partage&lt;br&gt;&amp;nbsp;&amp;nbsp;4) termine (exit 0) avant demarrage conteneur appli&lt;br&gt;&lt;br&gt;&lt;b&gt;kafka-producer.send(topic, msg)&lt;/b&gt;" style="text;html=1;fontSize=11.2;align=left;verticalAlign=top;spacingLeft=15;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="40" y="865" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="consumerBox" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E5FA3;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="1320" y="820" width="430" height="220" as="geometry" />
        </mxCell>
        <mxCell id="consumerHeader" value="Pod Consumer" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#1E3F6E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1320" y="820" width="430" height="40" as="geometry" />
        </mxCell>
        <mxCell id="consumerText" value="SA: consumer-sa&lt;br&gt;&lt;b&gt;initContainer vault-init&lt;/b&gt;:&lt;br&gt;  1) login K8s aupres de Vault&lt;br&gt;  2) vault read ibmcloud/creds/consumer-role&lt;br&gt;  3) ecrit API Key dans emptyDir partage&lt;br&gt;  4) termine avant demarrage conteneur appli&lt;br&gt;&lt;br&gt;&lt;b&gt;poll(cg-orders-processor)&lt;/b&gt;" style="text;html=1;fontSize=11.2;align=left;verticalAlign=top;spacingLeft=15;spacingTop=8;fontColor=#2C2C2C;" parent="1" vertex="1">
          <mxGeometry x="1320" y="865" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="rotBox" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#9AA0A6;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="40" y="1080" width="1710" height="270" as="geometry" />
        </mxCell>
        <mxCell id="rotTitle" value="Rotation detaillee (point sensible) - ne PAS supposer que le client Kafka recharge les credentials automatiquement" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#7A5C00;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
          <mxGeometry x="40" y="1085" width="1100" height="30" as="geometry" />
