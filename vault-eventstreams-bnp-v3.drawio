        <mxCell id="r5" value="Ancienne API Key&lt;br&gt;supprimee cote IAM&lt;br&gt;(revoquee, definitivement&lt;br&gt;invalide)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#58595B;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1320" y="1171" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rNote" value="⚠ Sans mecanisme de reload cote client, le Kafka client continue d&#39;utiliser l&#39;ancienne cle en memoire&#xa;jusqu&#39;a echec d&#39;authentification (SaslAuthenticationException) - d&#39;ou la necessite du callback ou du restart controle AVANT suppression." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#B08D00;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=12;fontColor=#7A5C00;" parent="1" vertex="1">
