        <mxCell id="r1" value="TTL approche&lt;br&gt;(lease Vault proche&lt;br&gt;de l&#39;expiration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#58595B;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="1171" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Vault: sys/leases/renew&lt;br&gt;(Renew Lease)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#58595B;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="300" y="1171" width="180" height="80" as="geometry" />
