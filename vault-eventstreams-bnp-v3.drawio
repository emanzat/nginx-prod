        <mxCell id="title" value="Vault Dynamic Secrets → IBM Cloud IAM → Event Streams (Kafka) - v3" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#00543C;align=center;verticalAlign=middle;" parent="1" vertex="1">
