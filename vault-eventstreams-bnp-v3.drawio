        <mxCell id="r3" value="API Key encore&lt;br&gt;renouvelable ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6E5;strokeColor=#B08D00;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="530" y="1161" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r3a" value="OUI&lt;br&gt;Renouvellement:&lt;br&gt;meme API Key,&lt;br&gt;TTL prolonge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3EF;strokeColor=#00915A;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="770" y="1121" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r3b" value="NON&lt;br&gt;Nouvelle API Key creee&lt;br&gt;+ ancien SID/cle&lt;br&gt;programme pour revocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDED;strokeColor=#B01B1B;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="770" y="1221" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Callback Kafka:&lt;br&gt;client recharge credentials&lt;br&gt;(SASL callback custom)&lt;br&gt;OU rollout restart controle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#58595B;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1030" y="1171" width="220" height="90" as="geometry" />
