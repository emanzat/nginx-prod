        </mxCell>
        <mxCell id="1WvtMMla1NQrwZRKOJ87-2" value="&lt;span style=&quot;color: rgb(46, 95, 163); font-size: 12px;&quot;&gt;10. Pod → Kafka : connexion SASL_SSL (API Key), consume&lt;/span&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e7">
          <mxGeometry x="0.5199" y="-2" relative="1" as="geometry">
