 rythme" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="132" width="300" height="56" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2b. Modifier l'IngressClass&lt;/b&gt;&lt;br&gt;Métiers · à leur rythme" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="216" width="300" height="56" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3. Désinstaller NGINX&lt;/b&gt;&lt;br&gt;CS31B · VIP toutes migrées" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="300" width="300" height="56" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4. Nodeport par défaut Gateway&lt;/b&gt;&lt;br&gt;AL / LB · après tous les clusters" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#712B13;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="384" width="300" height="56" as="geometry"/></mxCell><mxCell id="br" value="&lt;b&gt;Rollback possible avant l'étape 3&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="468" width="300" height="44" as="geometry"/></mxCell><mxCell id="eb0" style="endArrow=open;endFill=0;html=1;strokeColor=#888780;strokeWidth=1.5;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eb1" style="endArrow=open;endFill=0;html=1;strokeColor=#888780;strokeWidth=1.5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eb2" style="endArrow=open;endFill=0;html=1;strokeColor=#888780;strokeWidth=1.5;" edge="1" parent="1" source="b2" 